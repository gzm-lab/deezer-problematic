# Variables d'environnement pour Problematic.fyi

# Mot de passe pour l'interface d'administration
ADMIN_PASSWORD=change-moi

# Spotify (Client Credentials - pour les playlists publiques)
# À obtenir sur https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=ton_client_id
SPOTIFY_CLIENT_SECRET=ton_client_secret

# Deezer (optionnel - pour les playlists privées)
# DEEZER_ACCESS_TOKEN=ton_token

# Vercel Blob Storage (auto-configuré par Vercel)
# BLOB_READ_WRITE_TOKEN=...
